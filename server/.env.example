# ─── Pharmadesk Server Environment Variables ───
# Copy this file to .env and fill in real values

PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/pharmadesk?retryWrites=true&w=majority
JWT_ACCESS_SECRET=<generate-a-64-char-random-string>
JWT_REFRESH_SECRET=<generate-a-64-char-random-string>
CLIENT_URL=https://pharmadesk.vercel.app

# Email notifications config (using real SMTP. Falls back to Ethereal mock SMTP if blank)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
